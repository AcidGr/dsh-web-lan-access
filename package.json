{
  "name": "dsh-web-lan-access",
  "version": "1.1.0",
  "description": "LAN / remote access support for the DeepSeek Harness Web UI: self-contained 0.0.0.0 binding + crypto.randomUUID polyfill on plain-HTTP origins.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AcidGr/dsh-web-lan-access.git"
  },
  "homepage": "https://github.com/AcidGr/dsh-web-lan-access",
  "bugs": {
    "url": "https://github.com/AcidGr/dsh-web-lan-access/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "lan",
    "remote-access",
    "polyfill"
  ]
}